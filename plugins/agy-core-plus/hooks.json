{
  "agy-plus-lifecycle": {
    "SessionStart": [
      {
        "type": "command",
        "command": "python3 ~/.gemini/antigravity-cli/agy_plus/hooks_runner.py SessionStart",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "run_command|edit_file|write_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.gemini/antigravity-cli/agy_plus/hooks_runner.py PreToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 ~/.gemini/antigravity-cli/agy_plus/hooks_runner.py PreInvocation",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 ~/.gemini/antigravity-cli/agy_plus/hooks_runner.py Stop",
        "timeout": 30
      }
    ]
  }
}
